# 复制此文件为 .env 并填入你自己的密钥。.env 已被 .gitignore 忽略。

# ============ LLM API ============
# M2 情绪分析层使用。任填一个，优先级：Claude > DeepSeek > OpenAI
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# LLM_PROVIDER=deepseek   # 手动指定 provider（不写则按上面优先级自动）

# ============ 数据源 ============
# Tushare Pro token（可选，AkShare 用不到）
TUSHARE_TOKEN=

# 数据缓存路径（默认 ./data）
DATA_DIR=./data

# ============ 通知（M5，任选一个或多个渠道） ============

# 飞书群机器人 Webhook
FEISHU_WEBHOOK=

# 钉钉群机器人 Webhook
DINGTALK_WEBHOOK=
DINGTALK_SECRET=            # 可选：如启用加签校验则填

# 企业微信群机器人 Webhook
WECHAT_WEBHOOK=

# SMTP 邮件（4 项都要填才启用）
SMTP_HOST=                  # smtp.qq.com / smtp.163.com
SMTP_PORT=465
SMTP_USER=                  # 发件邮箱
SMTP_PASS=                  # SMTP 授权码（不是登录密码）
SMTP_TO=                    # 收件人，逗号分隔

# ============ Web 服务（M6） ============
WEB_HOST=127.0.0.1
WEB_PORT=8000
