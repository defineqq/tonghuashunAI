# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
build/
dist/
pip-log.txt
pip-delete-this-directory.txt

# --- 虚拟环境 ---
.venv/
venv/
env/
.python-version

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_meta

# --- 项目数据 & 日志（大文件、可重生成、含敏感信息，都不入库） ---
data/
!data/.gitkeep
logs/
!logs/.gitkeep
cache/
*.log
*.csv
*.parquet
*.h5
*.feather
*.pkl

# --- 模型产物 ---
models/*.bin
models/*.pt
models/*.onnx
models/*.ckpt

# --- 敏感配置：token / 账号密码 / API key ---
.env
.env.*
!.env.example
configs/secrets.yaml
configs/*.local.yaml

# --- Qbot 副本内部的运行时数据/缓存（源码本身入库，但运行时产物不入库） ---
vendor/Qbot/data/
vendor/Qbot/logs/
vendor/Qbot/cache/
vendor/Qbot/**/__pycache__/

# --- 其他 ---
.pytest_cache/
.coverage
htmlcov/
*.tmp
